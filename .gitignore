# Dependencies and build output
node_modules/
dist/
out/
build/
# What electron-builder writes: the .app, the .dmg and the .zip (`ui/package.json`).
release/

# The Windows model server, written at build time by `packaging/fetch-server-win.mjs` rather
# than tracked: 44 MB of DLLs is a lot to carry in every clone, so the archive they come from
# is pinned by size and SHA-256 in that file instead. The macOS server beside it *is* tracked,
# and stays that way — it is what every previous download was cut from.
ui/resources/server-win/
packaging/.cache/

# Local session state (contains conversation logs — never committed)
.emrg/

# The kernel's default store, written by `npm start` (same reason: it is the
# room's log, not source). `agents.yml` is the exception: it is configuration
# rather than state, and a fresh clone has to come with a roster or the kernel
# opens over a bot with no agents.
seek-data/*
!seek-data/agents.yml

# OS and editor
.DS_Store
*.log
*.tmp
.vscode/
.idea/
.probe-data/
