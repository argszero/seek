{
  "name": "seek-ui",
  "productName": "Seek",
  "version": "0.1.15",
  "private": true,
  "description": "The Seek desktop shell: a desktop messenger interface on the seek kernel.",
  "author": "argszero",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test \"electron/**/*.test.mjs\"",
    "dist:dir": "vite build && electron-builder --mac --arm64 --dir",
    "dist:mac": "vite build && electron-builder --mac --arm64",
    "dist:pkg": "vite build && electron-builder --mac --arm64 --dir && node ../packaging/make-pkg.mjs",
    "dist:notarize": "node ../packaging/notarize.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "app.seek.desktop",
    "productName": "Seek",
    "copyright": "MIT licensed",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "electron/**/*",
      "!electron/**/*.test.mjs",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../src",
        "to": "src",
        "filter": [
          "**/*.ts",
          "!**/*.test.ts",
          "prompts/*.json",
          "i18n/*.json"
        ]
      },
      {
        "from": "resources/src-package.json",
        "to": "src/package.json"
      },
      {
        "from": "resources/server",
        "to": "server"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.social-networking",
      "icon": "../assets/icon.png",
      "hardenedRuntime": true,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "notarize": false,
      "minimumSystemVersion": "12.0"
    }
  }
}
