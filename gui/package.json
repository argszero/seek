{
  "name": "seek-gui",
  "version": "0.1.0",
  "description": "seek GUI — Electron shell for the seek daemon. Loads webui/dist and talks to the daemon over the CONTRACT.md protocol.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "node node_modules/electron-builder/out/cli/cli.js --dir",
    "test": "node --test"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.argszero.seek",
    "productName": "seek",
    "files": [
      "main.js",
      "preload.js",
      "daemon_client.js",
      "package.json",
      "assets/**"
    ],
    "mac": {
      "category": "public.app-category.social-networking",
      "target": [
        { "target": "dir", "arch": ["arm64"] }
      ]
    },
    "win": {
      "target": [
        { "target": "dir", "arch": ["x64"] }
      ]
    }
  }
}
